# Copie este arquivo para backend/.env e ajuste o que quiser.
# Novas configurações entram aqui conforme cada fase do projeto for implementada.

# OBRIGATÓRIO: chave que assina os cookies das salas. Gere uma com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=troque-por-um-valor-aleatorio-longo

DEBUG=true

# Banco de dados (padrão: backend/quickdrop.db) e pasta dos arquivos enviados (padrão: backend/storage)
# DATABASE_URL=sqlite+aiosqlite:///C:/caminho/quickdrop.db
# STORAGE_DIR=C:/caminho/para/storage

# Limites de tamanho: por arquivo e por sala, em MB (todo tipo de arquivo é aceito)
MAX_FILE_SIZE_MB=100
MAX_ROOM_SIZE_MB=500

# Limites do texto compartilhado e de cada clip (KB), e quantos clips cabem numa sala
MAX_TEXT_SIZE_KB=1024
MAX_CLIP_SIZE_KB=64
MAX_CODE_CLIP_SIZE_KB=256
MAX_CLIPS_PER_ROOM=200

# Limites do servidor inteiro: total de arquivos (MB) e de salas ativas; e-mail de denúncias da página /sobre
MAX_TOTAL_STORAGE_MB=30720
MAX_ACTIVE_ROOMS=500
CONTACT_EMAIL=

# De quanto em quanto tempo (minutos) as salas expiradas são apagadas
CLEANUP_INTERVAL_MINUTES=5

# Limites de tentativas por endereço IP
RATE_LIMIT_LOOKUPS_PER_MINUTE=30
RATE_LIMIT_FAILED_JOINS_PER_MINUTE=5
RATE_LIMIT_ROOM_CREATIONS_PER_HOUR=20

# Opções de expiração da sala, em horas, e a opção padrão
ALLOWED_TTL_HOURS=1,12,24,48
DEFAULT_TTL_HOURS=12

# Mude para true quando o site estiver em HTTPS (internet)
COOKIE_SECURE=false
