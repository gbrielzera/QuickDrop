# Copie este arquivo para ".env" na pasta principal do projeto (no servidor) e preencha.

# Endereço do site, sem https://. Ex.: quickdrop-gabriel.duckdns.org
DOMAIN=quickdrop-seunome.duckdns.org

# OBRIGATÓRIO: chave que assina os cookies das salas. Gere uma com:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=troque-por-um-valor-aleatorio-longo

# E-mail para denúncias de abuso, mostrado na página /sobre (opcional)
CONTACT_EMAIL=

# Limites do servidor inteiro (o disco grátis da Oracle tem 200 GB; 30 GB deixa folga)
MAX_TOTAL_STORAGE_MB=30720
MAX_ACTIVE_ROOMS=500
